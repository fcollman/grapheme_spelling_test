{
  "name": "grapheme-spelling-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline single-file grapheme and phoneme error analysis for spelling tests",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "reference": "vite-node scripts/generate-reference.ts",
    "check:single": "node scripts/check-single-file.mjs"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "phonemizer": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.8"
  }
}
